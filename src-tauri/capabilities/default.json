{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main window",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "opener:default",
    {
      "identifier": "opener:allow-open-path",
      "allow": [{ "path": "$APPDATA/impresiones/*" }]
    },
    "sql:default",
    "sql:allow-execute",
    "fs:allow-write-file",
    "fs:allow-read-file",
    "fs:allow-copy-file",
    "fs:allow-mkdir",
    "fs:allow-exists",
    "fs:allow-remove",
    "fs:scope-appdata-recursive",
    "dialog:allow-save",
    "dialog:allow-open",
    "shell:allow-execute",
    "updater:default",
    "process:allow-restart"
  ]
}
